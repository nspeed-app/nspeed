# cloudflare servers
# see https://speed.cloudflare.com/ 
then -n "mono download from Cloudflare" get https://speed.cloudflare.com/__down?bytes=500000000
then -n "mono upload to Cloudflare" post https://speed.cloudflare.com/__up 200m
then -n "multi download from Cloudflare" get -n 4 https://speed.cloudflare.com/__down?bytes=100000000
then -n "multi upload to Cloudflare" post -n 4 https://speed.cloudflare.com/__up 100m